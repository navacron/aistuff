# ─────────────────────────────────────────────────
# RecRoomPick — Table Tennis Guide Environment Vars
# ─────────────────────────────────────────────────
#
# Copy this file to .env.local for local development.
# In Vercel: set these in Project Settings → Environment Variables.
#
# Generate a strong secret with: openssl rand -hex 32

# Shared between the API and the React bundle.
# API checks req.headers['x-api-key'] === API_SECRET.
# React sends it as: fetch('/api/tables', { headers: { 'X-Api-Key': VITE_API_SECRET } })
API_SECRET=replace-with-a-strong-random-secret
VITE_API_SECRET=replace-with-the-same-strong-random-secret

# Comma-separated list of production origins allowed by the API.
# Localhost is always allowed automatically (for dev).
# Example: https://recroompick.com,https://www.recroompick.com
ALLOWED_ORIGINS=https://recroompick.com,https://www.recroompick.com
